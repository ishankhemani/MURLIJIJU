rules_version = '2';

// ============================================================
// JijuBill Firestore Security Rules
//
// Current mode: DIRECT WRITE (no Cloud Functions deployed yet)
// Bills, customers, and settings can be written directly by the client.
//
// When you deploy Cloud Functions later, change allow write: if false
// for bills and customers to lock them down to server-side only.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Bills ─────────────────────────────────────────────────────────
    match /bills/{billId} {
      allow read:  if true;
      allow write: if true;   // Direct write — change to 'false' after deploying Cloud Functions
    }

    // ── Customers ─────────────────────────────────────────────────────
    match /customers/{customerId} {
      allow read:  if true;
      allow write: if true;
    }

    // ── Settings ──────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read:  if true;
      allow write: if true;
    }

    // ── Dashboard Aggregates ──────────────────────────────────────────
    match /dashboardAggregates/{docId} {
      allow read:  if true;
      allow write: if true;
    }

    // ── Bill number counters ──────────────────────────────────────────
    match /counters/{docId} {
      allow read:  if true;
      allow write: if true;
    }

    // ── Idempotency keys (Cloud Functions write these) ────────────────
    match /idempotencyKeys/{keyId} {
      allow read:  if false;
      allow write: if false;
    }

    // ── Deny everything else ──────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
